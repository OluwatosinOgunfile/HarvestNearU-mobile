{
  "expo": {
    "name": "HarvestNearU",
    "slug": "harvestnearu-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "harvestnearu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harvestnearu.marketplace",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HarvestNearU uses your location to rank nearby farms and capture farm locations.",
        "NSPhotoLibraryUsageDescription": "HarvestNearU uses your photo library for produce, receipt, and profile images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F3",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.harvestnearu.marketplace",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f8f3",
          "dark": {
            "backgroundColor": "#101813"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "HarvestNearU uses your photo library when you choose a profile or produce picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#17633f",
          "defaultChannel": "actionable"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "networkInspector": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://www.harvestnearu.com",
      "router": {},
      "eas": {
        "projectId": "3a88e028-9fa7-4da2-a7a6-4e3d6bfee114"
      }
    },
    "owner": "tosinogunfile"
  }
}
